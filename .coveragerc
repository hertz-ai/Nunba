[run]
# Measure runtime code coverage during the e2e suite.  Sources listed
# here are the Nunba code that ships to users — we explicitly track
# coverage of the code that runs in production, not the test scaffolding.
#
# `source` is the repo DIRECTORY, never a list of modules.  coverage 7
# treats a `source` entry that is not a directory as an importable module
# name and resolves it with importlib.util.find_spec() at start-up: the old
# `app.py` / `main.py` entries made coverage IMPORT and boot the whole
# desktop app (llama-server, HARTOS bootstrap, Tk) under pytest's argv, and
# its sys.modules restore then deleted modules those boot threads were still
# importing -- the KeyError 'conftest' / 'tests.e2e.conftest' collection
# failures in regression.yml.  Likewise `core` resolved to HARTOS's `core`
# package (Nunba has no core/ dir), folding HARTOS lines into this number
# against the omit rule below.  With `source = .` nothing is imported;
# app.py, main.py, wamp_router.py and the tts/llama/routes/models/desktop
# packages are measured (and reported at 0% until a test runs them), and
# the non-shipping trees are excluded by `omit`.
source =
    .

# Exclude known non-runtime artifacts.
omit =
    # Non-shipping top-level trees that `source = .` would otherwise walk
    # or record when a test executes them.
    scripts/*
    bench/*
    docs/*
    deploy/*
    packaging/*
    dist/*
    Output/*
    .backups/*
    .claude/*
    .uitest_*
    */__pycache__/*
    */tests/*
    */.venv/*
    */python-embed/*
    */python-embed-310-backup/*
    */build/*
    */landing-page/*
    */scripts/_dead_code_*
    */scripts/setup_freeze_*
    setup.py
    conftest.py
    # HARTOS is a separate repo with its own coverage gate — don't
    # fold its line counts into the Nunba budget, or every HARTOS
    # refactor would shift the Nunba number.  HARTOS code IS still
    # exercised at runtime (imported as a pip dep); we only omit it
    # from the Nunba report, not from what the tests drive.
    C:/Users/*/PycharmProjects/HARTOS/*
    */site-packages/HARTOS/*
    */site-packages/hevolveai/*
    */site-packages/hevolve_database/*

branch = True
parallel = True
concurrency = thread

[report]
# Lines that legitimately cannot be runtime-covered on CI.
exclude_also =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if sys\.platform ==
    if IS_MACOS
    if IS_LINUX
    except ImportError
    if getattr\(sys, .frozen., False\)

precision = 1
show_missing = False

# HARD QUALITY GATE — enforced by `coverage report --fail-under` and
# pytest-cov --cov-fail-under. Lower this only with explicit cause.
# Current observed baseline: ~5-10%, because most tests are still
# source-grep. This will FAIL every build until the e2e families land.
# That's intentional — it makes the "100% runtime coverage" target
# visible and unavoidable instead of aspirational.
fail_under = 99

[html]
directory = .coverage-html

[xml]
output = coverage.xml
